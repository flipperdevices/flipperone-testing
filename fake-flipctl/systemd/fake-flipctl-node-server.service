[Unit]
Description=fake-flipctl Node.js HTTP server (port 8899, serves web UI and JSON APIs)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node /rk3576-linux-tests/fake-flipctl/server.js
WorkingDirectory=/rk3576-linux-tests/fake-flipctl
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
