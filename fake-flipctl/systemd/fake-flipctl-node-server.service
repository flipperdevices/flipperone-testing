[Unit]
Description=fake-flipctl Node.js HTTP server (port 8899, serves web UI and JSON APIs)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node /flipperone-testing/fake-flipctl/server.js
WorkingDirectory=/flipperone-testing/fake-flipctl
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
