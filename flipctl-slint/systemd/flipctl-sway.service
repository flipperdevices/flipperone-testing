[Unit]
Description=Compositor owning the Flipper One panel, with flipctl inside it
After=systemd-logind.service
Wants=systemd-logind.service
# Claim the panel before any display manager wakes up and starts looking at cards.
Before=display-manager.service
Before=sddm.service
Conflicts=cog-seat1.service

[Service]
Type=simple
User=user
Group=user
SupplementaryGroups=input video render

# A real login session, so logind gives this process seat1's devices: the SPI
# panel and the Flipper's buttons, both tagged ID_SEAT=seat1 by
# 72-seat-cog.rules. Without a seat, wlroots' libinput backend takes seat0's
# devices, which are KDE's, and finds no buttons here at all.
PAMName=login
Environment=XDG_SEAT=seat1
# logind hands out devices only to a session of class "user"; a background session
# is refused with "Session class doesn't support taking device control", which is
# why cog gets away without this (it opens the DRM node directly rather than
# through logind) and a compositor does not.
Environment=XDG_SESSION_CLASS=user
Environment=XDG_SESSION_TYPE=wayland
Environment=WLR_BACKENDS=drm,libinput
# By path, never by number: card numbers move between kernels.
Environment=WLR_DRM_DEVICES=/dev/dri/by-path/platform-2acf0000.spi-cs-0-card

DevicePolicy=closed
DeviceAllow=/dev/dri/by-path/platform-2acf0000.spi-cs-0-card rw
DeviceAllow=/dev/dri/by-path/platform-27800000.gpu-render rw
DeviceAllow=char-input rw
DeviceAllow=/dev/tty0 rw

WorkingDirectory=/home/user/flipctl-slint
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/sway -c /etc/flipctl/sway.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
