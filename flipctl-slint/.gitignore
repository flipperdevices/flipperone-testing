# Build output.
target/

# Written by the golden-image harness when a render does not match, so it sits
# next to the golden for comparison. Never source.
*.actual.png

# Python bytecode from the apps.
__pycache__/
*.pyc

# Per-app virtualenvs, created on the device when an app's Python dependencies
# are installed. Machine-specific and rebuildable from APP_PIP.
apps/*/.venv/
