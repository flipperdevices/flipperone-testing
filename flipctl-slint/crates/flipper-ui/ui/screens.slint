// Single compilation entry point.
//
// slint-build sets SLINT_INCLUDE_GENERATED to the last file it compiles, so
// `include_modules!` can only ever pick up one. One entry file also means the
// shared components are defined once rather than duplicated per screen.
export { Root, Screen, ListItem, IdleLink, DetailRow, EthLink, EthDetailRow } from "root.slint";
