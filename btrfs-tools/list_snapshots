#!/bin/sh
# list_snapshots - list the read-only restore-point SNAPSHOTS under @snapshots (made by
# create_snapshot). PARENT is what each was snapshotted or received from (via Parent UUID);
# names are top-level paths (what create_profile and delete_snapshot take). For bootable
# profiles, see list_profiles. Works via a subvolid=5 (top-level) mount.
set -eu
die() { echo "error: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"
command -v btrfs >/dev/null 2>&1 || die "btrfs-progs not installed"

get() { printf '%s\n' "$1" | awk -v k="$2" -F':[[:space:]]+' 'index($0,k){print $2; exit}'; }

rootdev=$(findmnt -no SOURCE / | sed 's/\[.*//')
[ -n "$rootdev" ] || die "cannot determine root device"
top=$(mktemp -d)
map=$(mktemp)
rows=$(mktemp)
err=$(mount -o subvolid=5 "$rootdev" "$top" 2>&1) || die "mount failed: $err"
trap 'umount "$top" 2>/dev/null || true; rmdir "$top" 2>/dev/null || true; rm -f "$map" "$rows"' EXIT

# uuid -> "id <tab> path" for every subvolume (to resolve parents by UUID)
btrfs subvolume list -qu "$top" 2>/dev/null | awk '
{
    id=""; u=""; p=""
    for (i = 1; i <= NF; i++) {
        if      ($i == "ID")   id = $(i+1)
        else if ($i == "uuid") u  = $(i+1)
        else if ($i == "path") { p = $(i+1); for (j = i+2; j <= NF; j++) p = p" "$j; break }
    }
    if (u != "" && u != "-") print u"\t"id"\t"p
}' > "$map"

parent_of() {  # $1 = parent uuid -> "name (id)" or "-"
    case "$1" in ''|'-') printf '%s' "-"; return ;; esac
    awk -F'\t' -v u="$1" '
        $1==u { n=$3; sub(/.*\//,"",n); printf "%s (%s)", n, $2; f=1 }
        END   { if (!f) printf "-" }' "$map"
}

[ -d "$top/@snapshots" ] || die "@snapshots not found at top level"

emit() {  # $1=display name  $2=fs path
    info=$(btrfs subvolume show "$2" 2>/dev/null) || return 0
    id=$(get "$info" "Subvolume ID")
    otime=$(get "$info" "Creation time"); otime=${otime% +*}
    parent=$(parent_of "$(get "$info" "Parent UUID")")
    printf '%s\t%s\t%s\t%s\n' "$1" "${id:-?}" "${otime:-?}" "$parent" >> "$rows"
}

printf 'NAME\tID\tCREATED\tPARENT\n' > "$rows"
for s in "$top"/@snapshots/*; do
    [ -e "$s" ] || continue
    emit "@snapshots/${s##*/}" "$s"
done

# generic aligner: every column padded to its max width, last field unpadded
awk -F'\t' '
{ line[NR]=$0; nf=split($0,a,"\t"); for (i=1;i<=nf;i++) if (length(a[i])>w[i]) w[i]=length(a[i]) }
END {
    for (r=1; r<=NR; r++) {
        n=split(line[r], a, "\t"); out=""
        for (i=1; i<=n; i++) out = (i<n) ? out sprintf("%-*s  ", w[i], a[i]) : out a[i]
        print out
    }
}' "$rows"
