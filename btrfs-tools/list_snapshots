#!/bin/sh
# list_snapshots - list the bootable root subvolumes and snapshots. At the top level:
# the profile roots (@Desktop, @Minimal, ...), their _stock golden bases, writable bootable
# snapshots (@<profile>_<stamp>) and @.old_* leftovers; plus the read-only restore points
# under @snapshots. The KIND column tags each (profile/stock/snap/old). For each, PARENT is
# what it was snapshotted/received from (via Parent UUID). Names are top-level paths
# (what boot/restore/delete use). The booted subvolume is marked  <- booted.
set -eu
die() { echo "error: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"
command -v btrfs >/dev/null 2>&1 || die "btrfs-progs not installed"

get() { printf '%s\n' "$1" | awk -v k="$2" -F':[[:space:]]+' 'index($0,k){print $2; exit}'; }

rootdev=$(findmnt -no SOURCE / | sed 's/\[.*//')
[ -n "$rootdev" ] || die "cannot determine root device"
top=$(mktemp -d)
map=$(mktemp)
rows=$(mktemp)
mount -o subvolid=5 "$rootdev" "$top"
trap 'umount "$top" 2>/dev/null || true; rmdir "$top" 2>/dev/null || true; rm -f "$map" "$rows"' EXIT

# uuid -> "id <tab> path" for every subvolume (to resolve parents by UUID)
btrfs subvolume list -qu "$top" 2>/dev/null | awk '
{
    id=""; u=""; p=""
    for (i = 1; i <= NF; i++) {
        if      ($i == "ID")   id = $(i+1)
        else if ($i == "uuid") u  = $(i+1)
        else if ($i == "path") { p = $(i+1); for (j = i+2; j <= NF; j++) p = p" "$j; break }
    }
    if (u != "" && u != "-") print u"\t"id"\t"p
}' > "$map"

parent_of() {  # $1 = parent uuid -> "name (id)" or "-"
    case "$1" in ''|'-') printf '%s' "-"; return ;; esac
    awk -F'\t' -v u="$1" '
        $1==u { n=$3; sub(/.*\//,"",n); printf "%s (%s)", n, $2; f=1 }
        END   { if (!f) printf "-" }' "$map"
}

cur=$(btrfs subvolume show / 2>/dev/null) || cur=
cur_id=$(get "$cur" "Subvolume ID")
cur_path=$(printf '%s\n' "$cur" | head -n1)
[ -n "$cur_path" ] && echo "booted root: $cur_path (id ${cur_id:-?})"
echo

emit() {  # $1=display name  $2=fs path  -> append a TSV row
    info=$(btrfs subvolume show "$2" 2>/dev/null) || return 0
    id=$(get "$info" "Subvolume ID")
    otime=$(get "$info" "Creation time"); otime=${otime% +*}
    flags=$(get "$info" "Flags"); case "$flags" in *readonly*) flags=ro ;; *) flags=rw ;; esac
    parent=$(parent_of "$(get "$info" "Parent UUID")")
    case "$1" in
        @snapshots/*)   kind=snap ;;
        *_stock)        kind=stock ;;
        *.old_*)        kind=old ;;
        *_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_*) kind=snap ;;
        *)              kind=profile ;;
    esac
    mark=""; [ -n "$cur_id" ] && [ "$id" = "$cur_id" ] && mark="<- booted"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$kind" "${id:-?}" "${otime:-?}" "$flags" "$parent" "$mark" >> "$rows"
}

printf 'NAME\tKIND\tID\tCREATED\tRO\tPARENT\t\n' > "$rows"
# top level first: bootable roots, _stock bases, writable snapshots, @.old_* leftovers.
# Skip the shared data subvols and the @snapshots container.
for d in "$top"/@*; do
    [ -e "$d" ] || continue
    n=${d##*/}
    case "$n" in @|@home|@root|@snapshots|@var-log|@var-cache) continue ;; esac
    btrfs subvolume show "$d" >/dev/null 2>&1 || continue
    emit "$n" "$d"
done
# then the read-only restore points kept under @snapshots
for s in "$top"/@snapshots/*; do
    [ -e "$s" ] || continue
    emit "@snapshots/${s##*/}" "$s"
done

# generic aligner: every column padded to its max width, last field unpadded
awk -F'\t' '
{ line[NR]=$0; nf=split($0,a,"\t"); for (i=1;i<=nf;i++) if (length(a[i])>w[i]) w[i]=length(a[i]) }
END {
    for (r=1; r<=NR; r++) {
        n=split(line[r], a, "\t"); out=""
        for (i=1; i<=n; i++) out = (i<n) ? out sprintf("%-*s  ", w[i], a[i]) : out a[i]
        print out
    }
}' "$rows"
