#!/bin/sh
# delete_snapshot <@snapshots/NAME> - delete a read-only restore-point SNAPSHOT under
# @snapshots (as listed by list_snapshots). For bootable profiles, their _stock bases, or
# .old leftovers, use delete_profile. Confirms once. Works via a subvolid=5 (top-level) mount.
set -eu
die() { echo "error: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"
command -v btrfs >/dev/null 2>&1 || die "btrfs-progs not installed"

[ $# -ge 1 ] || die "usage: delete_snapshot <@snapshots/NAME>"
arg=$1
case "$arg" in *..*|/*) die "invalid name: $arg" ;; esac
case "$arg" in
    @snapshots/?*) ;;
    *) die "delete_snapshot only removes @snapshots restore points; for a profile use: delete_profile $arg" ;;
esac

rootdev=$(findmnt -no SOURCE / | sed 's/\[.*//')
[ -n "$rootdev" ] || die "cannot determine root device"
top=$(mktemp -d)
err=$(mount -o subvolid=5 "$rootdev" "$top" 2>&1) || die "mount failed: $err"
trap 'umount "$top" 2>/dev/null || true; rmdir "$top" 2>/dev/null || true' EXIT

[ -e "$top/$arg" ] || die "no such snapshot: $arg (see list_snapshots)"
btrfs subvolume show "$top/$arg" >/dev/null 2>&1 || die "not a snapshot: $arg"

printf "Delete restore-point snapshot '%s'? [y/N] " "$arg" >&2
read -r a </dev/tty 2>/dev/null || die "no terminal for confirmation; aborted"
case "$a" in y|Y|yes|YES) ;; *) die "aborted" ;; esac

btrfs subvolume delete "$top/$arg" >/dev/null
echo "deleted '$arg'"
