#!/bin/sh
# create_snapshot [-w|--rw] [tag...] - snapshot of root (@) into /.snapshots
#   default  : read-only (best for restore points and btrfs send)
#   -w/--rw  : writable snapshot, AND generate a BLS boot entry for it
# naming: @_YYYY-MM-DD_HH-MM-SS[_tag]   (tag slugified; spaces/odd chars -> '-')
set -eu
die() { echo "error: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"
command -v btrfs >/dev/null 2>&1 || die "btrfs-progs not installed"
SNAPDIR=/.snapshots

ro=-r
case "${1:-}" in
    -w|--rw) ro=  ; shift ;;
    -r|--ro) ro=-r; shift ;;
esac

tag=$*
if [ -n "$tag" ]; then
    tag=$(printf '%s' "$tag" | tr -c 'A-Za-z0-9._-' '-' | sed 's/-\{1,\}/-/g; s/^-//; s/-$//')
fi
name="@_$(date +%Y-%m-%d_%H-%M-%S)${tag:+_$tag}"
dest="$SNAPDIR/$name"
[ -e "$dest" ] && die "already exists: $dest"

btrfs subvolume snapshot $ro / "$dest" >/dev/null

# report the top-level subvol path (what rootflags=subvol= needs), not the mount path
svpath=$(btrfs subvolume show "$dest" | head -n1)

if [ -n "$ro" ]; then
    echo "created $svpath (read-only)"
else
    echo "created $svpath (writable)"
    # writable snapshots get a bootable BLS entry
    self=$(dirname "$0")
    if [ -x "$self/make_bls_entry" ]; then
        "$self/make_bls_entry" "$name" || echo "warning: BLS entry not created for $name" >&2
    elif command -v make_bls_entry >/dev/null 2>&1; then
        make_bls_entry "$name" || echo "warning: BLS entry not created for $name" >&2
    else
        echo "warning: make_bls_entry not found; no BLS entry created" >&2
    fi
fi
