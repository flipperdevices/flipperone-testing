#!/bin/sh
# create_boot_entry <subvol-name> - BLS type#1 entry to boot a WRITABLE root subvol,
# matching what 90-loaderentry.install writes for the image's own profiles:
#   filename      <entry-token>-<ver>-<name>.conf  (e.g. debian-7.1.0-...-@Desktop-2.conf)
#   linux         /boot/debian/<ver>/linux
#   devicetreedir /<name>/usr/lib/linux-image-<ver>   (the booted subvol's DTBs at the top level)
#   initrd        /boot/debian/<ver>/initrd.img-<ver>
# Same devicetreedir + sort-key as the profile entries, so a derived root boots with the
# identical device tree (incl. the SPI panel) and sorts together in the boot menu rather
# than as an odd snapshot-<name>.conf at the end.
# Requires U-Boot with CONFIG_BOOTMETH_BLS. The subvol is TOP-LEVEL (sibling of @),
# reached via a subvolid=5 mount, so /.snapshots need not be mounted.
set -eu
die() { echo "error: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"
command -v btrfs >/dev/null 2>&1 || die "btrfs-progs not installed"
ENTRYDIR=/boot/loader/entries
# U-Boot reads the btrfs TOP LEVEL (subvolid 5), so the in-entry devicetreedir must be
# prefixed with the subvol this entry boots: /<name>/usr/lib/linux-image-<ver> (where that
# root's DTBs live). A bare /usr/lib/... doesn't resolve at the top level -> U-Boot falls
# back to its control FDT. Set FDT_SUBVOL_PREFIX to override (e.g. "" if root isn't a subvol).
TITLE_MAX="${FLIPPER_TITLE_MAX:-26}"   # menu titles must fit the small screen (as in 90-loaderentry)

[ $# -ge 1 ] || die "usage: create_boot_entry <subvol-name>"
name=$1
case "$name" in */*|"") die "invalid subvolume name" ;; esac

rootdev=$(findmnt -no SOURCE / | sed 's/\[.*//')
[ -n "$rootdev" ] || die "cannot determine root device"
top=$(mktemp -d)
mount -o subvolid=5 "$rootdev" "$top"
trap 'umount "$top" 2>/dev/null || true; rmdir "$top" 2>/dev/null || true' EXIT

snap="$top/$name"
[ -d "$snap" ] || die "no such subvolume: $name"

flags=$(btrfs subvolume show "$snap" | awk -F':[[:space:]]+' '/Flags/{print $2}')
case "$flags" in *readonly*) die "$name is read-only; make a writable bootable root with: restore_snapshot <source> $name" ;; esac

# kernel version from the subvol's OWN tree, so modules + dtbs are self-consistent
ver=$(ls -1d "$snap"/usr/lib/linux-image-* 2>/dev/null | sed 's,.*/linux-image-,,' | sort -V | tail -n1)
[ -n "$ver" ] || die "no /usr/lib/linux-image-* found inside $name"
[ -e "/boot/debian/$ver/linux" ]           || die "kernel not staged: /boot/debian/$ver/linux"
[ -e "/boot/debian/$ver/initrd.img-$ver" ] || die "initrd not staged: /boot/debian/$ver/initrd.img-$ver"

uuid=$(findmnt -no UUID /)
[ -n "$uuid" ] || die "cannot read root fs UUID"

# entry token + sort-key: match the image's entries (os-release IMAGE_ID/ID -- "debian"
# on Flipper One; entry-token file overrides the filename token if present)
id=debian
[ -r /etc/os-release ] && id="$(. /etc/os-release 2>/dev/null; printf '%s' "${IMAGE_ID:-$ID}")" || :
[ -n "$id" ] || id=debian
token=$id
_t=""; [ -r /etc/kernel/entry-token ] && read -r _t < /etc/kernel/entry-token 2>/dev/null || :
[ -n "$_t" ] && token=$_t

# cmdline tail = current boot cmdline minus the bits we set ourselves
tail=$(tr ' ' '\n' < /proc/cmdline \
       | grep -Ev '^(root=|rootflags=|BOOT_IMAGE=|initrd=)' \
       | tr '\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//')

# Menu title trimming, identical to 90-loaderentry.install make_title: cap the total at
# TITLE_MAX by trimming the (long) kernel version while keeping the name suffix intact.
make_title() {
    _suf="$1"
    _avail=$(( TITLE_MAX - ${#_suf} - 1 ))
    if [ "$_avail" -ge 1 ]; then
        printf '%s %s' "$(printf '%s' "$ver" | cut -c"1-$_avail")" "$_suf"
    else
        printf '%s' "$_suf" | cut -c"1-$TITLE_MAX"
    fi
}

mkdir -p "$ENTRYDIR"
out="$ENTRYDIR/$token-$ver-$name.conf"
{
    echo "# Boot Loader Specification type#1 entry (Flipper One)"
    echo "title      $(make_title "$name")"
    echo "version    $ver"
    echo "sort-key   $id"
    echo "options    root=UUID=$uuid rootflags=subvol=$name${tail:+ $tail}"
    echo "linux      /boot/debian/$ver/linux"
    echo "devicetreedir ${FDT_SUBVOL_PREFIX-/$name}/usr/lib/linux-image-$ver"
    echo "initrd     /boot/debian/$ver/initrd.img-$ver"
} > "$out"

echo "wrote $out:"
echo "----------------------------------------"
cat "$out"
