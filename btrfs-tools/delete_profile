#!/bin/sh
# delete_profile <name> - delete a bootable PROFILE at the btrfs top level (as listed by
# list_profiles): a profile root (@Desktop, @Desktop-2, ...), a _stock golden base, or an
# @<profile>.old_* leftover. Also removes its BLS boot entry. For @snapshots restore points,
# use delete_snapshot.
# Confirms once; AGAIN if the target is read-only; a THIRD time (with a warning) for a _stock
# golden base. Refuses layout subvolumes and the currently booted profile.
set -eu
die() { echo "error: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"
command -v btrfs >/dev/null 2>&1 || die "btrfs-progs not installed"

[ $# -ge 1 ] || die "usage: delete_profile <name>"
arg=$1
case "$arg" in *..*|/*) die "invalid name: $arg" ;; esac
case "$arg" in
    @snapshots/*) die "delete_profile is for top-level profiles; for a restore point use: delete_snapshot $arg" ;;
esac

rootdev=$(findmnt -no SOURCE / | sed 's/\[.*//')
[ -n "$rootdev" ] || die "cannot determine root device"
cur_id=$(btrfs subvolume show / 2>/dev/null | awk -F':[[:space:]]+' '/Subvolume ID/{print $2; exit}')

top=$(mktemp -d)
mount -o subvolid=5 "$rootdev" "$top"
trap 'umount "$top" 2>/dev/null || true; rmdir "$top" 2>/dev/null || true' EXIT

[ -e "$top/$arg" ] || die "no such profile: $arg (see list_profiles)"
rel=$arg
case "$rel" in
    @|@home|@root|@snapshots|@var-log|@var-cache|boot)
        die "refusing to delete layout subvolume: $rel" ;;
esac
info=$(btrfs subvolume show "$top/$rel" 2>/dev/null) || die "not a profile: $rel"
tgt_id=$(printf '%s\n' "$info" | awk -F':[[:space:]]+' '/Subvolume ID/{print $2; exit}')
[ -n "$cur_id" ] && [ "$tgt_id" = "$cur_id" ] && die "refusing to delete the currently booted profile ($rel)"

# Tiered confirmation: once always; AGAIN if read-only; a THIRD time (with a warning) for _stock.
flags=$(printf '%s\n' "$info" | awk -F':[[:space:]]+' '/Flags/{print $2}')
is_ro=0;    case "$flags" in *readonly*) is_ro=1 ;; esac
is_stock=0; case "${rel##*/}" in *_stock) is_stock=1 ;; esac

confirm() {  # $1 = prompt; reads the terminal, aborts unless an explicit yes
    printf '%s [y/N] ' "$1" >&2
    read -r a </dev/tty 2>/dev/null || die "no terminal for confirmation; aborted"
    case "$a" in y|Y|yes|YES) ;; *) die "aborted" ;; esac
}

confirm "Delete profile '$rel'?"
[ "$is_ro" = 1 ] && confirm "'$rel' is READ-ONLY (stock / received); delete anyway?"
if [ "$is_stock" = 1 ]; then
    echo "WARNING: '$rel' is a _stock GOLDEN BASE, the factory-reset source for its profile;" >&2
    echo "         deleting it means that profile can no longer be reset to factory." >&2
    confirm "Confirm a THIRD time: permanently delete the golden base '$rel'?"
fi

btrfs subvolume delete "$top/$rel" >/dev/null
echo "deleted $rel"

# drop this profile's BLS entries by content (rootflags=subvol=<rel>), matching 90-loaderentry.
for entry in /boot/loader/entries/*.conf; do
    [ -f "$entry" ] || continue
    esv=$(awk '$1=="options"{for(i=2;i<=NF;i++) if($i ~ /^rootflags=subvol=/) s=$i}
               END{sub(/^rootflags=subvol=/,"",s); print s}' "$entry")
    [ "$esv" = "$rel" ] && { rm -f "$entry"; echo "removed boot entry $entry"; }
done
