# exclude test results
results/*

# but keep the results folder
!results/.gitkeep

# macOS
.DS_Store

# Voice recorder output — captured WAVs / MP3s / OGGs are per-
# device runtime data, not source. The Node server creates this
# dir on demand and writes every take into it.
sound/voice_recordings/

# fake-flipctl2 local-only files. `.claude/settings.local.json`
# is Claude Code's per-session permission allowlist — grows
# with command history.
fake-flipctl2/.claude/settings.local.json

# Local developer debug config — boots straight into a single
# scene on page load (see js/debug_config.js + the
# DEBUG_SCENE_MAP block in main.js). Per-developer iteration
# convenience; must not land in shared commits. The pre-commit
# hook in .githooks/pre-commit refuses to commit when the file
# is staged OR when it has `enabled: true` on disk.
fake-flipctl2/js/debug_config.js

# Local Claude Code / desktop-app config (preview launcher etc.) —
# per-developer, never part of the repo.
.claude/

# TV Media Box demo: unused HDMI drafts (the demo uses HMDI_BG.png,
# HMDI_FG.png and HDMI_cable_transparent.png) and the source clips /
# sprite sheet of the earlier video version.
fake-flipctl2/assets/tv_media_box/*.mp4
fake-flipctl2/assets/tv_media_box/hdmi_port_bg_sheet.png
fake-flipctl2/assets/tv_media_box/HDMI_cable.png
fake-flipctl2/assets/tv_media_box/HDMI_cable_narrow.png
fake-flipctl2/assets/tv_media_box/hdmi_port_bg.png
fake-flipctl2/assets/tv_media_box/hdmi_port_bg_narrow.png
fake-flipctl2/assets/tv_media_box/hdmi_port_fg.png
fake-flipctl2/assets/tv_media_box/hdmi_port_fg_narrow.png
