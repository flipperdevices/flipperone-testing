[Unit]
Description=fake-flipctl Wayland kiosk — cage compositor running Cog browser on tty1 (256x144 SPI LCD)
After=fake-flipctl2-node-server.service
Conflicts=getty@tty1.service
After=systemd-user-sessions.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/cage -- cog http://127.0.0.1:8899
WorkingDirectory=/home/user/fake-flipctl
Restart=on-failure
RestartSec=3

TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=tty
StandardError=journal

RuntimeDirectory=fake-flipctl-cage
Environment=XDG_RUNTIME_DIR=/run/fake-flipctl-cage
Environment=LIBSEAT_BACKEND=builtin

[Install]
WantedBy=fake-flipctl.target
